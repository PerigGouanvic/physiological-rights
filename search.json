---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- assign entries = "" | split: "" -%}
{%- for doc in site.documents -%}
  {%- unless doc.hidden or doc.search_exclude -%}
    {%- assign entries = entries | push: doc -%}
  {%- endunless -%}
{%- endfor -%}
{%- for page in site.pages -%}
  {%- if page.title and page.url != "/search.json" and page.search_exclude != true -%}
    {%- assign entries = entries | push: page -%}
  {%- endif -%}
{%- endfor -%}
{%- for item in entries -%}
  {%- assign coll = item.collection | default: "page" -%}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "collection": {{ coll | jsonify }},
    "description": {{ item.description | default: "" | jsonify }},
    "content": {{ item.content | strip_html | normalize_whitespace | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
